<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ACTION_DELETE lo exige desde API 28. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Peso por uso: lo habilita el usuario en Ajustes > Acceso al uso. Sin él, orden manual. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Sin esto, desde API 30 el sistema oculta las apps a la consulta. No hace falta QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/icon"
        android:theme="@style/Launcher">
        <profileable android:shell="true" />

        <activity
            android:name=".app.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:windowSoftInputMode="adjustNothing|stateHidden"
            android:configChanges="uiMode|locale|layoutDirection|fontScale|density|screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sesiones de medios y puntitos de notificación; lo prende el usuario si activa "Mostrar lo que suena". -->
        <service
            android:name=".media.MediaAccessService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- El filtro HOME vive en un alias apagado por defecto (-PhomeEnabled=true lo prende). -->
        <activity-alias
            android:name=".Home"
            android:targetActivity=".app.HomeActivity"
            android:enabled="${homeEnabled}"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
