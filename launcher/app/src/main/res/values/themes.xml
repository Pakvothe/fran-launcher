<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ventana del color del atardecer: sin flash blanco antes del primer frame. Barras transparentes (edge-to-edge). -->
    <style name="Launcher" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/arranque</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
    <color name="arranque">#2A1630</color>
</resources>
